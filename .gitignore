# ========================================================
# Git Ignore Configuration
# ========================================================

# Environment variables & secrets
.env
.env*.local
*.env
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit secrets & cache
.streamlit/secrets.toml
.streamlit/cache/

# IDE & Editor settings
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Output data, logs & evaluation history
*.log
data/evaluation_history.csv
