# ========================================================
# Groq API Configuration
# ========================================================
# 1. Sign up for a free Groq account: https://console.groq.com/
# 2. Generate an API Key at: https://console.groq.com/keys
# 3. Create a file named '.env' in this directory and copy this content into it.
# 4. Replace 'your_groq_api_key_here' with your real Groq API key.
# ========================================================

GROQ_API_KEY=your_groq_api_key_here

# Supported Groq Models include:
# - openai/gpt-oss-120b (Recommended: powerful reasoning)
# - openai/gpt-oss-20b (Lightweight, ultra-fast)
# - qwen/qwen3.8-27b
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b
